generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model Submission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  area      String
  kakuyaku  String
  createdAt DateTime @default(now())

  @@map("確約を保存する")
}
